# Copy this file to .env and replace every dummy secret before starting the server.
# Never commit .env, access tokens, refresh tokens, or the OAuth signing key.

KB_KEY_A=dummy-replace-with-a-unique-random-value
KB_KEY_B=dummy-replace-with-a-different-unique-random-value

# Public HTTPS origin and canonical MCP resource URL. Use your own domain.
OAUTH_ISSUER=https://engram.example.invalid
OAUTH_RESOURCE=https://engram.example.invalid/mcp
OAUTH_OWNER_SECRET=dummy-replace-with-a-random-owner-approval-secret
OAUTH_SIGNING_KEY=dummy-replace-with-a-random-server-only-hmac-signing-key
OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=300
OAUTH_REFRESH_TOKEN_TTL_SECONDS=1209600

# For `cargo run`, use an absolute writable directory for refresh-token family state.
# Docker Compose overrides this with its named /state volume.
OAUTH_STATE_DIR=/tmp/engram-mcp-oauth-state

# Local Markdown knowledge base. Docker Compose mounts KB_HOST_PATH at /kb.
KB_ROOT=/path/to/knowledge-base
KB_HOST_PATH=./knowledge-base
KB_PUBLIC_DIRS=10_tech,20_projects
KB_PRIVATE_DIRS=90_private

# Optional write-only Markdown inbox. `append_note` is available only to the
# kb:private scope when this existing directory is writable. It is not searched
# or fetched. For `cargo run`, use the host's absolute path; Compose replaces it
# with /inbox and mounts this directory separately from the read-only /kb mount.
INBOX_ROOT=/path/to/knowledge-base/99_inbox
# Leave this empty to disable append_note in Compose. The `-` interpolation in
# compose.yaml preserves an explicit empty value instead of restoring /inbox.
INBOX_CONTAINER_PATH=/inbox
INBOX_WRITES_PER_HOUR=10
INBOX_MAX_NOTE_BYTES=32768
INBOX_MAX_TOTAL_BYTES=8388608

MCP_BIND_ADDR=0.0.0.0:8080
MCP_ALLOWED_HOSTS=engram.example.invalid,engram-mcp:8080
ALLOWED_ORIGINS=

MAX_READ_BYTES=65536
MAX_SEARCH_RESPONSE_BYTES=24576
MAX_SEARCH_FILE_BYTES=1048576
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
RUST_LOG=info

# Needed only when the optional cloudflared service is enabled.
TUNNEL_TOKEN=dummy-replace-with-a-cloudflare-tunnel-token
